# Router image for GLM-5.2 PD with /v1/responses + /v1/messages support.
# Source-level patches (route_responses, route_messages, vendored openai-protocol)
# are committed to the repo — no runtime patching needed.
#
# Build (from repo root):
#   docker build -f docker/rocm-mi308x-glm52-pd/Dockerfile.router \
#     -t mirrors.tencent.com/ti-platform/sglang-glm52-308x-pd-router:pd-resp-msg-v2 .

FROM lmsysorg/sglang-rocm:v0.5.15-rocm720-mi30x-20260710

LABEL maintainer="guofutan"
LABEL description="SGLang PD Router with /v1/responses + /v1/messages + codex tool-type support"

# Overlay sgl-model-gateway source (includes vendored openai-protocol + route_messages)
COPY sgl-model-gateway/ /sgl-workspace/sglang/sgl-model-gateway/

# Build + install the wheel (vendored openai-protocol via [patch.crates-io] in Cargo.toml)
RUN cd /sgl-workspace/sglang/sgl-model-gateway/bindings/python && \
    CARGO_BUILD_JOBS=8 maturin build --release --out dist --features vendored-openssl && \
    pip install --force-reinstall --no-deps dist/sglang_router-0.3.2-*.whl && \
    python3 -c "import sglang_router; print('sglang_router OK')"

CMD ["/bin/bash"]
