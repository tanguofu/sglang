# Mooncake patch: add MC_DISABLE_HIP_TRANSPORT env var
# 
# Problem: Mooncake's HIP transport (intra-node GPU P2P via XGMI/IPC) is
# installed by default when USE_HIP is defined. The selectTransport() function
# picks HIP (priority 4) over RDMA (priority 2) for multi-protocol segments.
# But hipIpcOpenMemHandle fails with error 17 (invalid device pointer) on
# ROCm when the target GPU memory is on a different node.
#
# Fix: Add MC_DISABLE_HIP_TRANSPORT=1 env var to skip HIP transport install.
# Without HIP, selectTransport() correctly routes inter-node transfers via RDMA.
#
# Apply: cd Mooncake && patch -p1 < disable_hip_transport.patch
--- a/mooncake-transfer-engine/src/transfer_engine_impl.cpp
+++ b/mooncake-transfer-engine/src/transfer_engine_impl.cpp
@@ -403,6 +403,12 @@
         // HIP transport handles intra-node GPU P2P via XGMI/IPC and can
         // coexist with the cross-node transport (RDMA/TCP) selected above.
+        // MC_DISABLE_HIP_TRANSPORT=1 skips HIP install — needed on ROCm where
+        // hipIpcOpenMemHandle fails for inter-node GPU memory (error 17).
+        if (!std::getenv("MC_DISABLE_HIP_TRANSPORT") ||
+            std::string(std::getenv("MC_DISABLE_HIP_TRANSPORT")) != "1") {
             Transport* hip_transport =
                 multi_transports_->installTransport("hip", nullptr);
             if (!hip_transport) {
@@ -411,6 +417,9 @@
             } else {
                 LOG(INFO) << "HIP transport installed for intra-node GPU P2P";
             }
+        } else {
+            LOG(INFO) << "HIP transport disabled by MC_DISABLE_HIP_TRANSPORT=1";
+        }
 #endif
     }
 #endif
