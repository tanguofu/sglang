{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "labels": {
      "app": "glm52-router"
    },
    "name": "glm52-router",
    "namespace": "kube-system",
    "resourceVersion": "",
    "uid": ""
  },
  "spec": {
    "containers": [
      {
        "args": [
          "set -euo pipefail\necho \"=== SGLang PD Router (responses enabled) ===\"\nexec python3 -m sglang_router.launch_router \\\n  --pd-disaggregation \\\n  --prefill http://21.151.225.152:30000 \\\n  --decode http://21.151.225.172:30000 \\\n  --host 0.0.0.0 --port 30002 \\\n  --prometheus-port 19096 \\\n  --model-path /data/model/glm52-fp8 \\\n  --log-level info\n"
        ],
        "command": [
          "/bin/bash",
          "-c"
        ],
        "env": [
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          }
        ],
        "image": "mirrors.tencent.com/ti-platform/sglang-glm52-308x-pd-router:responses-0715",
        "imagePullPolicy": "IfNotPresent",
        "name": "router",
        "ports": [
          {
            "containerPort": 30002,
            "hostPort": 30002,
            "protocol": "TCP"
          }
        ],
        "resources": {},
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/dev/shm",
            "name": "shm"
          },
          {
            "mountPath": "/data",
            "name": "data"
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access-zc5th",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": true,
    "hostNetwork": true,
    "nodeName": "node-21.151.225.172",
    "preemptionPolicy": "PreemptLowerPriority",
    "priority": 0,
    "restartPolicy": "Always",
    "schedulerName": "default-scheduler",
    "securityContext": {},
    "serviceAccount": "default",
    "serviceAccountName": "default",
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "operator": "Exists"
      }
    ],
    "volumes": [
      {
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "64Gi"
        },
        "name": "shm"
      },
      {
        "hostPath": {
          "path": "/data",
          "type": "Directory"
        },
        "name": "data"
      },
      {
        "name": "kube-api-access-zc5th",
        "projected": {
          "defaultMode": 420,
          "sources": [
            {
              "serviceAccountToken": {
                "expirationSeconds": 3607,
                "path": "token"
              }
            },
            {
              "configMap": {
                "items": [
                  {
                    "key": "ca.crt",
                    "path": "ca.crt"
                  }
                ],
                "name": "kube-root-ca.crt"
              }
            },
            {
              "downwardAPI": {
                "items": [
                  {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "metadata.namespace"
                    },
                    "path": "namespace"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}